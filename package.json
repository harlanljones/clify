{
  "name": "clify-monorepo",
  "version": "1.7.0",
  "private": true,
  "description": "Monorepo for cliamp-clify (retro terminal music player) and clify CLI (extended Spotify & agent framework)",
  "author": "harlan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/harlanljones/clify.git"
  },
  "homepage": "https://github.com/harlanljones/clify#readme",
  "bugs": {
    "url": "https://github.com/harlanljones/clify/issues"
  },

  "engines": {
    "node": ">=18"
  },

  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "dev:tui": "turbo run dev --filter=cliamp-clify",
    "dev:cli": "turbo run dev --filter=clify"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  },
  "packageManager": "pnpm@10.34.5"
}
